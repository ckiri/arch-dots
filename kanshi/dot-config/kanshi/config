profile notebook {
    output eDP-1 enable
}
profile desk {
    output "LG Electronics LG ULTRAFINE 508NTZNM6853" enable {
        mode 3840x2160@59.995998Hz
        scale 1.5
	adaptive_sync on
    }
}
profile dock {
    output eDP-1 disable
    output "LG Electronics LG ULTRAFINE 508NTZNM6853" enable {
        mode 3840x2160@59.995998Hz
        scale 1.5
	adaptive_sync on
    }
}
profile extend {
    output eDP-1 enable
    output "LG Electronics LG ULTRAFINE 508NTZNM6853" enable {
        mode 3840x2160@59.995998Hz
        scale 1.5
    }
}
profile mirror {
    output eDP-1 enable
    output HDMI-A-1 enable {
        mode 1920x1080@60.000000Hz
        scale 1.0
    }
    exec wl-present mirror eDP-1 --fullscreen-output HDMI-A-1 --fullscreen
}
