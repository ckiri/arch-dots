profile framework {
    output eDP-1 enable {
        mode 2256x1504@59.999001Hz
        position 0,0
        scale 1.5
    }
}
profile desk {
    output "LG Electronics LG ULTRAFINE 508NTZNM6853" enable {
        mode 3840x2160@59.995998Hz
        position 0,0
        scale 1.5
	adaptive_sync on
    }
}
# Mirror the two outputs in use, internal output is mirrored to external output
profile mirror {
    output eDP-1 enable {
        mode 2256x1504@59.999001Hz
        position 0,0
        scale 1.5
    }
    output DP-1 enable {
        position 0,-1504
        scale 1
    }
    exec wl-present mirror eDP-1 --fullscreen-output DP-1 --fullscreen
}
profile extend {
    output eDP-1 enable {
        mode 2256x1504@59.999001Hz
        scale 1.5
        position 0,-1504
    }
    output DP-1 enable {
        position 0,0
        scale 1.25
    }
}
profile external {
    output eDP-1 disable
    output "LG Electronics LG ULTRAFINE 508NTZNM6853" enable {
        mode 3840x2160@59.995998Hz
        position 0,0
        scale 1.5
	adaptive_sync on
    }
}
profile external {
    output eDP-1 disable
    output DP-1 enable {
        position 0,0
        scale 1.25
    }
}
